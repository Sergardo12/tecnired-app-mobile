<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".TecniRedApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.My_App_Project"
        tools:targetApi="31">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsKey}"/>
        <activity
            android:name=".ui.activity.Home.MetodoPago"
            android:exported="false" />
        <activity
            android:name=".ui.activity.ServiciosPost.ServiciosPostActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Home.PerfilUsuario"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Servicios.ServicioActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Home.DatosTrabajador"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Home.DatosPersonales"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Solicitudes.Lista_Solicitudes"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Register.FormRegisCliente"
            android:exported="false" />
        <activity
            android:name=".ui.activity.Register.FormInicioSesion"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".utils.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />


</manifest>