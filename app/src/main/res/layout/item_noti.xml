<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:background="@drawable/card_notificacion_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iconoNotificacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background"
            android:padding="8dp"
            android:src="@drawable/ic_plomero" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconoNotificacion"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tituloNotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo gasfitero Disponible"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_dark" />

            <TextView
                android:id="@+id/descripcionNotificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hay un nuevo gasfitero cerca de ti!!"
                android:textSize="14sp"
                android:textColor="@color/text_light" />
        </LinearLayout>

        <TextView
            android:id="@+id/horaNotificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="2 mins ago"
            android:textSize="12sp"
            android:textColor="@color/text_light" />

        <View
            android:id="@+id/dotLeido"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_dot"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/horaNotificacion"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
