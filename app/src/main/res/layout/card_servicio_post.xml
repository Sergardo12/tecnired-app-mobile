<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardServicioPost"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CCCCCC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen superior -->
        <ImageView
            android:id="@+id/imgServicio"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"/>

        <!-- Contenido del post -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Usuario"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción breve del servicio ofrecido aquí..."
                android:textSize="13sp"
                android:textColor="#444444"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/categoriaServicioPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carpinteria"
                android:textColor="@color/purple_500"
                android:layout_marginTop="4dp"
                />

            <TextView
                android:id="@+id/tvTarifa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 100.00"
                android:textColor="#00796B"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <!-- Botón VER alineado a la derecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerDetalle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver"
                    app:cornerRadius="8dp"
                    app:iconPadding="4dp"
                    app:iconTint="@color/black"
                    android:textColor="@color/black"
                    app:backgroundTint="@android:color/transparent"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
