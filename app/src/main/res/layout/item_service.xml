<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:background="@drawable/card_notificacion_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iconoService"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background"
            android:padding="8dp"
            android:src="@drawable/ic_plomero" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconoService"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/descripcionService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cables sueltos en mi casita"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:ellipsize="end"
                android:layout_marginEnd="50dp"/>

            <TextView
                android:id="@+id/distanciaService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="plaza de armas de trujillo"
                android:textSize="14sp"
                android:textColor="@color/text_light"
                android:ellipsize="end"
                android:layout_marginEnd="50dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/fechaService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="2 mins ago"
            android:textSize="12sp"
            android:textColor="@color/text_light" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
