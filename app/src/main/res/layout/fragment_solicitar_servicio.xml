<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.fragment.SolicitarServicioFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solicitar Servicio"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp" />

        <!-- Selector de categoría -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/design_default_color_primary"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoCompleteCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Selecciona una categoría"
                android:inputType="none"
                android:textColor="@color/black"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Rango de referencia -->
        <TextView
            android:id="@+id/tvRangoReferencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estos servicios pueden costar entre 40 y 100 soles"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Dirección -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección del servicio">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/inputDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción del servicio -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descripción del servicio solicitado">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDescripcionServicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:maxLines="5"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Mapa -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="@color/amarillo" />

        <!-- Botón Solicitar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitarServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Solicitar Servicio"
            android:enabled="false"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/design_default_color_primary_variant"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
